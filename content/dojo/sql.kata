   (7,4,'2026-11-01T10:00:00','198.51.100.4',0),(8,4,'2026-11-01T10:00:30','198.51.100.4',0),(9,4,'2026-11-01T10:01:00','198.51.100.4',0),(10,4,'2026-11-01T10:02:00','198.51.100.4',1),
   (11,5,'2026-11-01T11:00:00','10.0.0.15',0),(12,5,'2026-11-01T11:00:40','10.0.0.15',1),
   (13,6,'2026-11-02T02:00:00','10.0.0.50',1),(14,1,'2026-11-02T08:30:00','10.0.0.11',1),
